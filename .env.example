NODE_ENV=development
PORT=4100
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4100
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=indongduong_sql_dev
DB_USER=indongduong_sql_dev
DB_PASSWORD=
DB_POOL_LIMIT=4
DB_POOL_QUEUE_LIMIT=20
# Exact allowlist. Set cPanel-prefixed name explicitly in production.
DB_EXPECTED_NAME=indongduong_sql_dev
TEST_DB_NAME=indongduong_sql_test
TEST_DB_USER=indongduong_sql_test
TEST_DB_PASSWORD=
ALLOW_TEST_DATABASE=0
# Generate privately: npm run setup:secret. Never put in VITE variables.
SETUP_SECRET=
SESSION_HOURS=12
# New private buckets only; Phase 01 never contacts R2.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional portable Windows helper. Configure absolute paths privately on each PC.
MARIADB_EXECUTABLE=
MARIADB_CONFIG=
