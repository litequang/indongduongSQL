# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (.env)
# ==============================================================================
# Copy file này thành file .env hoặc .env.local trên máy tính của bạn trước khi build.
# Điền thông tin Firebase Project của bạn lấy từ Firebase Console.
# ==============================================================================

# Thông tin kết nối Firebase Cloud Firestore (Lấy từ Firebase Console > Project Settings > Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chế độ triển khai (PRODUCTION: Yêu cầu đăng nhập mã PIN cho từng thợ, ẩn công cụ demo)
# Giá trị: PRODUCTION hoặc DEMO
VITE_DEPLOYMENT_MODE=PRODUCTION

# Mã PIN Quản Trị Viên (Mặc định: 8888)

# Thông tin tùy chỉnh xưởng in ban đầu (Tùy chọn)
VITE_DEFAULT_WORKSHOP_NAME=
VITE_DEFAULT_WORKSHOP_PHONE=
VITE_DEFAULT_WORKSHOP_SHORTNAME=
VITE_DEFAULT_WORKSHOP_ADDRESS=
VITE_DEFAULT_WORKSHOP_TAGLINE=
VITE_DEFAULT_WORKSHOP_LOGO=
VITE_DEFAULT_WORKSHOP_WEBSITE=
