{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, machine assignment and authentication credentials.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID (e.g. u-admin-1, u-printer-1)"
        },
        "name": {
          "type": "string",
          "description": "Full name of the worker",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "RBAC role in the workshop",
          "enum": ["DEVELOPER", "ADMIN", "MANAGER", "DESIGNER", "SALE", "PRINTER", "FINISHER"]
        },
        "username": {
          "type": "string",
          "description": "Account login username",
          "maxLength": 60
        },
        "phone": {
          "type": "string",
          "description": "Worker contact phone number",
          "maxLength": 20
        },
        "avatar": {
          "type": "string",
          "description": "Avatar image URL or path"
        },
        "pin": {
          "type": "string",
          "description": "PIN code / Shift password",
          "maxLength": 32
        },
        "machineAssigned": {
          "type": "string",
          "description": "Default assigned printer machine"
        },
        "active": {
          "type": "boolean",
          "description": "Whether user account is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update ISO timestamp"
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Soft delete timestamp"
        }
      },
      "required": ["id", "name", "role", "active"]
    },
    "ProductionOrder": {
      "title": "ProductionOrder",
      "description": "Production print job order with items, workflow milestones, timeline and issues.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order ID (e.g. order-174000-xyz)"
        },
        "code": {
          "type": "string",
          "description": "Human-readable order code (e.g. LIN-0220)",
          "pattern": "^LIN-[0-9]{4,6}$"
        },
        "status": {
          "type": "string",
          "description": "Order lifecycle status",
          "enum": ["DRAFT", "WAITING_ACCEPTANCE", "WAITING_PLATE", "PRINTING", "PRINTED", "FINISHING", "COMPLETED", "ISSUE", "CANCELLED"]
        },
        "productName": {
          "type": "string",
          "description": "Product / Bag description",
          "maxLength": 255
        },
        "paperType": {
          "type": "string",
          "description": "Paper type (Kraft, MG, OP, Fort, Duplex, etc.)"
        },
        "paperGsm": {
          "type": "string",
          "description": "Paper weight GSM"
        },
        "paperWidth": {
          "type": "number",
          "description": "Width in cm"
        },
        "paperHeight": {
          "type": "number",
          "description": "Height in cm"
        },
        "totalSheets": {
          "type": "number",
          "description": "Total print sheet quantity target"
        },
        "color": {
          "type": "string",
          "description": "Print color specs"
        },
        "printerId": {
          "type": "string",
          "description": "Assigned printer machine ID or user ID"
        },
        "printerName": {
          "type": "string",
          "description": "Assigned printer machine name"
        },
        "createdById": {
          "type": "string",
          "description": "Creator user UID"
        },
        "createdByName": {
          "type": "string",
          "description": "Creator user display name"
        },
        "createdByRole": {
          "type": "string",
          "description": "Creator role when order was created"
        },
        "plateType": {
          "type": "string",
          "enum": ["NEW", "OLD"]
        },
        "plateStatus": {
          "type": "string",
          "enum": ["NOT_SENT", "SENT", "RECEIVED", "OLD_PLATE", "DAMAGED", "REISSUE_SENT"]
        },
        "plateDate": {
          "type": "string"
        },
        "originalPlateDate": {
          "type": "string"
        },
        "plateNote": {
          "type": "string"
        },
        "actualPrintedSheets": {
          "type": "number"
        },
        "spoilageSheets": {
          "type": "number"
        },
        "printedNote": {
          "type": "string"
        },
        "printedImageUrl": {
          "type": "string"
        },
        "printingCompletedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishingStatus": {
          "type": "string",
          "enum": ["WAITING", "PROCESSING", "COMPLETED"]
        },
        "finishingNote": {
          "type": "string"
        },
        "isUrgent": {
          "type": "boolean"
        },
        "urgentReason": {
          "type": "string"
        },
        "isReprint": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "code", "status", "paperType", "totalSheets", "createdById", "createdAt"]
    },
    "AppConfigEntity": {
      "title": "AppConfigEntity",
      "description": "Workshop configuration settings, company branding, materials and permission overrides.",
      "type": "object",
      "properties": {
        "company": {
          "type": "object"
        },
        "production": {
          "type": "object"
        },
        "workflow": {
          "type": "object"
        },
        "features": {
          "type": "object"
        },
        "system": {
          "type": "object"
        },
        "permissions": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SavedDesign": {
      "title": "SavedDesign",
      "description": "Saved bag print design in library.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "productName": {
          "type": "string"
        },
        "paperType": {
          "type": "string"
        },
        "bagSize": {
          "type": "string"
        },
        "printCount": {
          "type": "number"
        },
        "lastPrintedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "imageUrl", "customerName", "productName"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Real-time production notification alert.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "targetRole": {
          "type": "string",
          "enum": ["DEVELOPER", "ADMIN", "MANAGER", "DESIGNER", "SALE", "PRINTER", "FINISHER"]
        },
        "orderId": {
          "type": "string"
        },
        "orderCode": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "title", "message", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Workshop employee profiles and authentication credentials."
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/ProductionOrder"
      },
      "description": "Manufacturing production orders collection."
    },
    "/settings/app": {
      "schema": {
        "$ref": "#/entities/AppConfigEntity"
      },
      "description": "Centralized workshop configurations, paper types, machine list and permission overrides."
    },
    "/saved_designs/{designId}": {
      "schema": {
        "$ref": "#/entities/SavedDesign"
      },
      "description": "Design library items for quick repeat order creations."
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/NotificationItem"
      },
      "description": "Workshop alerts and real-time audio notifications."
    }
  }
}
