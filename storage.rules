rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage Rules deliberately resolve the same Firebase Auth UID ->
    // business identity mapping used by Firestore Rules. Calls below use the
    // identity document only; PRINTER has no Storage write permission.
    function hasActiveIdentity() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/auth_identities/$(request.auth.uid)).data.active == true &&
        firestore.get(/databases/(default)/documents/auth_identities/$(request.auth.uid)).data.businessUserId is string &&
        firestore.get(/databases/(default)/documents/auth_identities/$(request.auth.uid)).data.role in ['DEVELOPER', 'ADMIN', 'MANAGER', 'DESIGNER', 'SALE', 'PRINTER', 'FINISHER'];
    }

    function role() {
      return firestore.get(/databases/(default)/documents/auth_identities/$(request.auth.uid)).data.role;
    }

    function businessUserId() {
      return firestore.get(/databases/(default)/documents/auth_identities/$(request.auth.uid)).data.businessUserId;
    }

    function hasRole(roles) {
      return hasActiveIdentity() && role() in roles;
    }

    function canCreateProductionAsset() {
      return hasRole(['DEVELOPER', 'ADMIN', 'MANAGER', 'DESIGNER', 'SALE']);
    }

    function isValidImage() {
      return request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isNewObject() {
      return resource == null;
    }

    function isValidImageName(imageName) {
      return imageName.matches('^[A-Za-z0-9_-]{8,96}\\.(jpg|png|webp)$');
    }

    // Designer/Sale-side order artwork. Printer accounts may read these
    // images but cannot replace them or write to another asset namespace.
    match /production-orders/{orderId}/items/{itemId}/{imageName} {
      allow read: if hasActiveIdentity();
      allow create: if canCreateProductionAsset() && isNewObject() && isValidImage() && isValidImageName(imageName);
      allow update: if false;
      allow delete: if canCreateProductionAsset();
    }

    match /sales-orders/{salesOrderId}/items/{itemId}/images/{imageName} {
      allow read: if hasActiveIdentity();
      allow create: if hasRole(['DEVELOPER', 'ADMIN', 'MANAGER', 'SALE']) &&
        isNewObject() && isValidImage() && isValidImageName(imageName);
      allow update: if false;
      allow delete: if hasRole(['DEVELOPER', 'ADMIN', 'MANAGER', 'SALE']);
    }

    match /avatars/{userId}/{imageName} {
      allow read: if hasActiveIdentity();
      allow create: if hasActiveIdentity() && (businessUserId() == userId || hasRole(['DEVELOPER', 'ADMIN'])) &&
        isNewObject() && isValidImage() && isValidImageName(imageName);
      allow update: if false;
      allow delete: if hasActiveIdentity() && (businessUserId() == userId || hasRole(['DEVELOPER', 'ADMIN']));
    }

    match /settings/company-logo/{imageName} {
      allow read: if hasActiveIdentity();
      allow create: if hasRole(['DEVELOPER', 'ADMIN']) && isNewObject() && isValidImage() && isValidImageName(imageName);
      allow update: if false;
      allow delete: if hasRole(['DEVELOPER', 'ADMIN']);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
