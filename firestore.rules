rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // This collection is provisioned only by a trusted administrator backend or
    // Firebase Console. Client role claims and users/{id}.role are never used
    // as authorization sources.
    function hasActiveIdentity() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/auth_identities/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/auth_identities/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/auth_identities/$(request.auth.uid)).data.businessUserId is string &&
        get(/databases/$(database)/documents/auth_identities/$(request.auth.uid)).data.role in ['DEVELOPER', 'ADMIN', 'MANAGER', 'DESIGNER', 'SALE', 'PRINTER', 'FINISHER', 'WAREHOUSE'];
    }

    function businessUserId() {
      return get(/databases/$(database)/documents/auth_identities/$(request.auth.uid)).data.businessUserId;
    }

    function identityRole() {
      return get(/databases/$(database)/documents/auth_identities/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return hasActiveIdentity() && identityRole() in ['DEVELOPER', 'ADMIN'];
    }

    function isManager() {
      return hasActiveIdentity() && identityRole() in ['DEVELOPER', 'ADMIN', 'MANAGER'];
    }

    function isDesigner() {
      return hasActiveIdentity() && identityRole() in ['DEVELOPER', 'ADMIN', 'MANAGER', 'DESIGNER'];
    }

    function isPrinter() {
      return hasActiveIdentity() && identityRole() == 'PRINTER';
    }

    function isSale() {
      return hasActiveIdentity() && identityRole() in ['DEVELOPER', 'ADMIN', 'MANAGER', 'SALE'];
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function canManageImageRegistry(data) {
      return (data.entityType == 'PRODUCTION_ORDER_ITEM' && (isDesigner() || isSale())) ||
        (data.entityType == 'SALES_ORDER_ITEM' && isSale()) ||
        (data.entityType == 'USER_AVATAR' && (data.entityId == businessUserId() || isAdmin())) ||
        (data.entityType == 'COMPANY_LOGO' && data.entityId == 'company' && isAdmin());
    }

    function isValidImageRegistryRecord(imageId, data) {
      return data.keys().hasAll([
          'imageId', 'providerType', 'providerConfigId', 'objectKey',
          'originalFileName', 'contentType', 'size', 'sha256',
          'createdAt', 'createdBy', 'status', 'entityType', 'entityId'
        ]) &&
        data.keys().hasOnly([
          'imageId', 'providerType', 'providerConfigId', 'objectKey',
          'originalFileName', 'contentType', 'size', 'sha256', 'width', 'height',
          'createdAt', 'createdBy', 'status', 'entityType', 'entityId', 'parentEntityId',
          'updatedAt', 'deletedAt'
        ]) &&
        data.imageId == imageId && isValidId(data.imageId) &&
        data.providerType == 'FIREBASE_STORAGE' &&
        data.providerConfigId == 'firebase-primary' &&
        data.objectKey is string && data.objectKey.size() > 0 && data.objectKey.size() <= 512 &&
        data.originalFileName is string && data.originalFileName.size() > 0 && data.originalFileName.size() <= 512 &&
        data.contentType in ['image/jpeg', 'image/png', 'image/webp'] &&
        data.size is int && data.size > 0 && data.size <= 5 * 1024 * 1024 &&
        data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$') &&
        data.createdAt is string && data.createdBy == businessUserId() &&
        data.status == 'ACTIVE' && isValidId(data.entityId) &&
        !data.keys().hasAny(['updatedAt', 'deletedAt']) &&
        (!data.keys().hasAny(['width']) || (data.width is int && data.width > 0)) &&
        (!data.keys().hasAny(['height']) || (data.height is int && data.height > 0)) &&
        (data.entityType in ['USER_AVATAR', 'COMPANY_LOGO'] ||
          (data.parentEntityId is string && isValidId(data.parentEntityId)));
    }

    function isValidUser(data) {
      return data.id is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.role in ['DEVELOPER', 'ADMIN', 'MANAGER', 'DESIGNER', 'SALE', 'PRINTER', 'FINISHER', 'WAREHOUSE'] &&
        data.active is bool;
    }

    function isValidOrder(data) {
      return data.id is string &&
        data.code is string && data.code.size() <= 32 &&
        data.status in ['DRAFT', 'WAITING_ACCEPTANCE', 'ACCEPTED', 'WAITING_PLATE', 'WAITING_PRINT', 'PRINTING', 'PRINTED', 'FINISHING', 'COMPLETED', 'CANCELLED'] &&
        data.paperType is string && data.paperType.size() <= 50 &&
        data.totalSheets is number && data.totalSheets > 0 &&
        data.createdAt is string;
    }

    // Printer assignments use stable business user IDs, never Firebase Auth UIDs.
    function isAssignedPrinter(order) {
      return isPrinter() &&
        order.printerId is string &&
        order.printerId == businessUserId();
    }

    function isAllowedPrinterStatusTransition() {
      return request.resource.data.status == resource.data.status ||
        (resource.data.status == 'WAITING_ACCEPTANCE' &&
          request.resource.data.status in ['ACCEPTED', 'WAITING_PRINT']) ||
        (resource.data.status in ['ACCEPTED', 'WAITING_PRINT'] &&
          request.resource.data.status in ['WAITING_PRINT', 'PRINTING']);
    }

    function printerAcknowledgedLatestRevision() {
      return !request.resource.data.keys().hasAny(['productionRevision']) ||
        (request.resource.data.productionRevision is int &&
          request.resource.data.printerAcknowledgedRevision is int &&
          request.resource.data.printerAcknowledgedRevision >= request.resource.data.productionRevision);
    }

    // Plate and issue tracking are parallel records. Starting print is gated
    // only by assignment, lifecycle state and acknowledgement of the latest
    // technical revision.
    function printerStartIsSafe() {
      return request.resource.data.status != 'PRINTING' ||
        (printerAcknowledgedLatestRevision() &&
          (!resource.data.keys().hasAny(['cancellationRequest']) || resource.data.cancellationRequest.status != 'PENDING'));
    }

    match /auth_identities/{uid} {
      // The authenticated user may read only their own mapping to resolve the
      // Firebase UID -> stable business-user ID relationship.
      allow get: if hasActiveIdentity() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if hasActiveIdentity();
      // Staff provisioning and privileged lifecycle changes are performed only
      // by Cloud Functions with the Admin SDK. Browser clients may update only
      // their own non-privileged profile fields.
      allow create, delete: if false;
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pin', 'firebaseUid']) &&
        hasActiveIdentity() && request.auth.uid != null && userId == businessUserId() &&
        isValidUser(request.resource.data) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'avatar', 'avatarImage', 'username', 'machineAssigned', 'updatedAt'
        ]);
    }

    match /orders/{orderId} {
      allow read: if hasActiveIdentity();
      allow create: if hasActiveIdentity() && isValidId(orderId) && isValidOrder(request.resource.data) &&
        request.resource.data.status == 'WAITING_ACCEPTANCE' && (isDesigner() || isSale());
      allow update: if hasActiveIdentity() && isValidId(orderId) && isValidOrder(request.resource.data) && (
        (isDesigner() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'timeline', 'comments', 'isReprint',
            'isUrgent', 'urgentReason', 'urgentSetBy', 'urgentSetName',
            'updatedAt', 'deletedAt'
          ])
        )) ||
        (isAssignedPrinter(resource.data) && isAllowedPrinterStatusTransition() && printerStartIsSafe() &&
          // A printer may record acceptance time only as part of accepting an
          // assigned order. Later printer actions must not rewrite it.
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['acceptedAt']) ||
            (resource.data.status == 'WAITING_ACCEPTANCE' &&
              request.resource.data.status in ['ACCEPTED', 'WAITING_PRINT'])) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acceptedAt', 'printingStartedAt', 'timeline',
          'printerAcknowledgedRevision',
          'comments', 'updatedAt'
        ])) ||
        (isSale() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isUrgent', 'urgentReason', 'urgentSetBy', 'urgentSetName', 'finishingNote',
          'comments', 'timeline', 'updatedAt'
        ]))
      );
      allow delete: if isAdmin() || (isDesigner() && resource.data.status == 'DRAFT');
    }

    match /production_draft_backups/{draftId} {
      allow read: if hasActiveIdentity() &&
        (resource.data.createdBy == businessUserId() || isDesigner());
      allow create: if hasActiveIdentity() && isValidId(draftId) && isDesigner() &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.createdBy == businessUserId();
      allow update: if hasActiveIdentity() && isValidId(draftId) &&
        (resource.data.createdBy == businessUserId() || isManager()) &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if hasActiveIdentity() &&
        (resource.data.createdBy == businessUserId() || isManager());
    }

    match /settings/{settingId} {
      allow read: if hasActiveIdentity();
      allow create, update, delete: if isAdmin();
    }

    match /saved_designs/{designId} {
      allow read: if hasActiveIdentity();
      allow create, update: if hasActiveIdentity() && isValidId(designId) && (isDesigner() || isSale());
      allow delete: if isAdmin() || isDesigner();
    }

    match /notifications/{notificationId} {
      allow read: if hasActiveIdentity();
      allow create: if hasActiveIdentity() && isValidId(notificationId);
      allow update: if hasActiveIdentity() && isValidId(notificationId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if hasActiveIdentity();
      allow create: if hasActiveIdentity() && isValidId(customerId) && (isAdmin() || isSale() || isManager()) &&
        request.resource.data.deletedAt == null;
      allow update: if hasActiveIdentity() && isValidId(customerId) && (isAdmin() || isSale() || isManager());
      allow delete: if isAdmin();
    }

    match /customer_import_jobs/{jobId} {
      allow read: if hasActiveIdentity();
      allow create, update: if hasActiveIdentity() && isValidId(jobId) && (isAdmin() || isSale() || isManager());
      allow delete: if isAdmin();
    }

    match /sales_orders/{orderId} {
      allow read: if hasActiveIdentity();
      // Browser may create/edit a DRAFT's descriptive data. Lifecycle state is
      // authoritative in callable Functions and may never be directly changed.
      allow create: if hasActiveIdentity() && isValidId(orderId) && (isDesigner() || isSale()) &&
        request.resource.data.status == 'DRAFT' && request.resource.data.deletedAt == null;
      allow update: if hasActiveIdentity() && (isAdmin() || isSale() || isManager()) &&
        request.resource.data.status == resource.data.status &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'confirmedAt', 'confirmedBy', 'completedAt', 'cancelledAt', 'deletedAt'
        ]);
      allow delete: if isAdmin();
    }

    match /sales_order_items/{itemId} {
      allow read: if hasActiveIdentity();
      allow create: if hasActiveIdentity() && isValidId(itemId) && (isDesigner() || isSale()) &&
        request.resource.data.status == 'NEW' && request.resource.data.deletedAt == null;
      allow update: if hasActiveIdentity() && (isAdmin() || isSale() || isManager() || isDesigner()) &&
        request.resource.data.status == resource.data.status &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'linkedProductionItemIds', 'allocatedQuantity', 'deletedAt'
        ]);
      allow delete: if isAdmin() || (isSale() && resource.data.status == 'DRAFT');
    }

    match /image_registry/{imageId} {
      allow read: if hasActiveIdentity();
      allow create: if hasActiveIdentity() &&
        isValidImageRegistryRecord(imageId, request.resource.data) &&
        canManageImageRegistry(request.resource.data);
      allow update: if hasActiveIdentity() && canManageImageRegistry(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt', 'updatedAt']) &&
        request.resource.data.status == 'DELETED' &&
        request.resource.data.deletedAt is string && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /storage_provider_configs/{providerConfigId} {
      // Provider configs include backend-only Secret Manager references.
      // Developer clients must use the sanitized callable API instead.
      allow read, create, update, delete: if false;
    }

    match /storage_upload_operations/{operationId} {
      // Presigned URLs and pinned provider/secret-version references are
      // returned or resolved only through canonically authorized callables.
      allow read, create, update, delete: if false;
    }

    match /storage_runtime/{documentId} {
      // System-level routing is callable/Admin-SDK only.
      allow read, create, update, delete: if false;
    }

    match /storage_backup_policies/{policyId} {
      // Backup policy changes are Developer-callable/Admin-SDK only.
      allow read, create, update, delete: if false;
    }

    match /image_replicas/{replicaId} {
      // Disaster-recovery metadata is Developer-callable/Admin-SDK only.
      allow read, create, update, delete: if false;
    }

    match /image_backup_jobs/{jobId} {
      // Jobs, leases and errors are server-authoritative.
      allow read, create, update, delete: if false;

      match /items/{itemId} {
        allow read, create, update, delete: if false;
      }
    }

    match /counters/{counterId} {
      allow read, create, update: if hasActiveIdentity() && (isDesigner() || isSale());
      allow delete: if false;
    }

    match /finished_goods/{fgId} {
      allow read: if hasActiveIdentity();
      allow create, update, delete: if false;
    }

    match /finishing_tasks/{taskId} {
      allow read: if hasActiveIdentity();
      allow create, update, delete: if false;
    }

    match /workflow_issues/{issueId} {
      allow read: if hasActiveIdentity();
      allow create, update, delete: if false;
    }

    match /warehouse_dispatches/{dispatchId} {
      allow read: if hasActiveIdentity();
      allow create, update, delete: if false;
    }

    match /warehouse_dispatch_items/{itemId} {
      allow read: if hasActiveIdentity();
      allow create, update, delete: if false;
    }

    match /shipments/{shipmentId} {
      allow read: if hasActiveIdentity();
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isManager();
      allow create: if hasActiveIdentity() && isValidId(logId) &&
        request.resource.data.userId == businessUserId() &&
        request.resource.data.userRole == identityRole();
      allow update, delete: if false;
    }

    match /_system_health/{healthId} {
      allow get: if isAdmin();
      // A health probe uses setDoc(..., { merge: true }). Creation must keep
      // the document's strict schema, while an existing legacy diagnostic
      // field must not turn a safe lastPing/app refresh into a false alarm.
      allow create: if isAdmin() && healthId == 'ping' &&
        request.resource.data.keys().hasOnly(['lastPing', 'app']);
      allow update: if isAdmin() && healthId == 'ping' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPing', 'app']);
      allow delete, list: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
