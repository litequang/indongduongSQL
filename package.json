{
  "name": "indongduong-sql",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node app.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:migrate": "tsx server/database/migrate-cli.ts",
    "setup:secret": "node scripts/setup-secret.mjs",
    "local:db": "node scripts/local-db.mjs",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:legacy": "tsx --test legacy/firebase/tests/auth-initialization-state.test.ts legacy/firebase/tests/developer-demo-preview.test.ts legacy/firebase/tests/production-eligibility.test.ts legacy/firebase/tests/submission-lock.test.ts legacy/firebase/tests/workflow-v2-local.test.ts",
    "check:runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "mysql2": "^3.15.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
